PORT=4000
NODE_ENV=development
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/outsider?retryWrites=true&w=majority
# Long random string: openssl rand -hex 32
JWT_SECRET=
# Comma-separated frontend origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Used in email links and Google redirect
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# Brevo (transactional email)
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=Outsider

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin login, created automatically the first time the server connects to an empty database.
# Change the password afterwards in Admin → Platform settings → Admin login.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678

# Optional: `npm run seed` with this true also creates demo user@gmail.com and brand@gmail.com (password 12345678)
SEED_DEMO_ACCOUNTS=false

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
