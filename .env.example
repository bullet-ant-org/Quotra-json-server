# Outsider API base URL. When set, the app uses the real backend (live chat, Cloudinary uploads, Paystack).
# When empty, the app runs in demo mode with browser-only sample data.
VITE_API_URL=
# Google Maps JavaScript API key (Maps JS + Directions + Street View enabled). Empty = OpenStreetMap fallback.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Cloud Map ID for styled vector maps
VITE_GOOGLE_MAP_ID=
